# Copy to .env and fill in. .env is gitignored.

# ---- Database (matches docker-compose.yml) ----
RX_DATABASE_URL=postgresql://rx:rx@localhost:5433/rxclarify

# ---- Generation provider: "openai" or "bedrock" ----
RX_LLM_PROVIDER=openai

# ---- OpenAI ----
# Standard variable name, read directly by langchain-openai. Never commit it.
OPENAI_API_KEY=
RX_OPENAI_MODEL=gpt-5.6-luna
# GPT-5 family models are reasoning models. langchain-openai strips
# `temperature` for them at every effort level EXCEPT "none". Grounded citation
# from supplied excerpts needs no reasoning tokens, so "none" is both the
# cheapest option and the only one where temperature=0 is honoured. Raising it
# silently discards determinism.
RX_OPENAI_REASONING_EFFORT=none

# ---- AWS Bedrock (alternative provider) ----
# Model access is granted per-model AND per-region in the Bedrock console.
# IAM needs bedrock:InvokeModel (+ bedrock:ApplyGuardrail for Phase 3).
RX_BEDROCK_MODEL=anthropic.claude-haiku-4-5
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Retrieval / generation knobs ----
RX_TOP_K=6
RX_MAX_TOKENS=1024

# ---- Ingestion ----
# Optional: raises the openFDA quota from 1,000/day to 120,000/day.
# Free key: https://open.fda.gov/apis/authentication/
RX_OPENFDA_API_KEY=
