# Copy to .env and fill in. .env is gitignored.

# ---- Database (matches docker-compose.yml) ----
RX_DATABASE_URL=postgresql://rx:rx@localhost:5433/rxclarify

# ---- Generation provider: "ollama" (free, local) or "bedrock" (AWS) ----
RX_LLM_PROVIDER=ollama

# Ollama (local dev). Model must be pulled: `ollama pull qwen2.5:3b`
RX_OLLAMA_BASE_URL=http://localhost:11434
RX_OLLAMA_MODEL=qwen2.5:3b

# AWS Bedrock. Model access must be requested per-model, per-region in the
# Bedrock console. IAM needs bedrock:InvokeModel (+ bedrock:ApplyGuardrail for Phase 3).
RX_BEDROCK_MODEL=anthropic.claude-haiku-4-5
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Retrieval / generation knobs ----
RX_TOP_K=6
RX_MAX_TOKENS=1024

# ---- Ingestion ----
# Optional: raises the openFDA quota from 1,000/day to 120,000/day.
# Free key: https://open.fda.gov/apis/authentication/
RX_OPENFDA_API_KEY=
